{
  "name": "sheepbotz-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/tests.json && node scripts/report.mjs",
    "check": "npm run test:coverage && npm run build && node scripts/traceability.mjs",
    "headless": "node scripts/headless.mjs"
  },
  "dependencies": {"acorn": "8.15.0", "three": "0.180.0"},
  "devDependencies": {"vite": "6.4.1", "vitest": "3.2.4", "@vitest/coverage-v8": "3.2.4", "jsdom": "26.1.0"},
  "engines": {"node": ">=22"}
}
